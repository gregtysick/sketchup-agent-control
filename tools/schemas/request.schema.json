{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "created_at", "command", "args", "confirm"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "format": "uuid"},
    "created_at": {"type": "string", "maxLength": 64},
    "command": {"enum": ["get_status", "inspect_model", "inspect_selection", "create_test_cube"]},
    "args": {"type": "object"},
    "confirm": {"type": "boolean"}
  },
  "allOf": [{
    "if": {"properties": {"command": {"const": "create_test_cube"}}},
    "then": {"properties": {"args": {"const": {"side_inches": 120}}, "confirm": {"const": true}}},
    "else": {"properties": {"args": {"maxProperties": 0}, "confirm": {"const": false}}}
  }]
}
